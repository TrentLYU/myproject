# 复制为 .env.local 后填写。真实密钥只保存在本机，不要提交或发到聊天中。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 私下提供给老师的演示访问码，不要写入网页、公开报告或 GitHub。
TRENT_CHAT_ACCESS_CODE=

# 服务端硬限额：单 IP 每分钟/每天、全站每天，以及单次最大输出 Token。
TRENT_CHAT_IP_MINUTE_LIMIT=5
TRENT_CHAT_IP_DAILY_LIMIT=10
TRENT_CHAT_GLOBAL_DAILY_LIMIT=100
TRENT_CHAT_MAX_OUTPUT_TOKENS=256

# 需要紧急停用时设为 false，再更新 Supabase Secret；主页其他功能不受影响。
CHAT_ENABLED=true
